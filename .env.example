# Gemini API key for Gemma 4 online triage (Google AI Studio). Never commit .env.
EXPO_PUBLIC_GEMINI_API_KEY=
# Gemma 4 model on the Gemini API
EXPO_PUBLIC_GEMMA_MODEL=gemma-4-26b-a4b-it
# AirNow API key (docs.airnowapi.org) for the air-quality line on Prepare.
EXPO_PUBLIC_AIRNOW_API_KEY=
# Demo mode: every 911, agency and contact action goes to DEMO_RECIPIENT instead. Keep "1" for the hackathon.
EXPO_PUBLIC_DEMO_MODE=1
# Where demo mode sends calls and texts. Empty = 305-555-0100 (fictional, reaches no one).
# For the live demo, put a teammate's phone here so the text visibly arrives. Never 911.
EXPO_PUBLIC_DEMO_RECIPIENT=
# Supabase project for neighbor alerts (run supabase/migrations/0001_alerts.sql first). Empty = alerts stay on this phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
